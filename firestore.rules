rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Stripe Extension: Customers collection
    // The extension requires specific rules to allow the client to create checkout sessions
    match /customers/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
    }

    // Orders: Users can read/write orders if authenticated
    // Reverted to simple check to ensure compatibility with existing data/queries
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Menu: Public read access
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if false; // Admin only
    }
    
    // Users: Profile data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}